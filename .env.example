# Copy to .env for local dev. On Hostinger, set these in hPanel.
# The deploy does not read this file, and it must never contain a real return.

# Sign-in gate. Every page and API requires these.
TAXES_AUTH_USER=lance
TAXES_AUTH_PASSWORD=change-me

# Where the saved return and last computed output live.
# Hostinger replaces the app directory on each deploy, so this must be
# outside it. Default when unset: a sibling folder named taxes-data.
# Prefer an absolute path on the server.
# TAXES_DATA_PATH=/home/USER/taxes-data
